{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["id","version","feature_schema","rules"],
  "properties":{
    "id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},
    "feature_schema":{"type":"string","pattern":"^1\\."},
    "rules":{"type":"array","minItems":1,"maxItems":1024,"items":{"$ref":"#/$defs/rule"}}
  },
  "$defs":{"rule":{"type":"object","additionalProperties":false,"required":["id","version","title","description","severity","confidence","condition","explanation"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"integer","minimum":1},"title":{"type":"string"},"description":{"type":"string"},"severity":{"enum":["informational","low","medium","high","critical"]},"confidence":{"enum":["low","medium","high"]},"condition":{"type":"object"},"explanation":{"type":"string"}}}}
}
